# Salin file ini jadi ".env" lalu isi nilainya.
# Catatan: server.js saat ini membaca variabel dari environment OS
# (PORT, HOST, NODE_ENV), jadi nilai di sini dipakai jika kamu pakai
# "dotenv" atau meng-include file ini dari systemd/PM2.

# Port HTTP (default: 3000)
PORT=3000

# Alamat bind (default: 0.0.0.0 supaya bisa diakses dari luar)
HOST=0.0.0.0

# production | development
NODE_ENV=production
