# Salin file ini jadi ".env" lalu isi nilainya. JANGAN commit file .env.
# server/db.js membaca file .env ini secara otomatis saat server dijalankan
# lewat `node server.js` (lokal / VPS). Di Vercel, isi variabel yang sama
# lewat Project Settings → Environment Variables.

# === Wajib untuk produksi ===

# Mode produksi: mengaktifkan cookie Secure, HSTS, password admin aman,
# dan mematikan seed voucher contoh. Isi "production" di server asli.
NODE_ENV=production

# Database produksi (Neon PostgreSQL). Kosongkan untuk SQLite lokal.
# WAJIB diisi bila deploy ke Vercel/serverless — tanpa ini data HILANG
# setiap fungsi dimulai ulang.
# Contoh: postgresql://user:password@ep-xxxx.aws.neon.tech/dbname?sslmode=require
DATABASE_URL=

# Akun admin pertama yang dibuat server saat database masih kosong.
# Ganti emailnya dan buat password yang kuat (minimal 8 karakter).
# Bila ADMIN_PASSWORD dikosongkan di produksi, server membuat password
# ACAK dan mencetaknya SEKALI di log saat pertama kali jalan — simpan baik-baik.
ADMIN_EMAIL=admin@warungmami.id
ADMIN_PASSWORD=

# === Opsional ===

# Port HTTP (default: 3000). Di hosting biasanya diisi otomatis oleh platform.
PORT=3000

# Alamat bind (default: 0.0.0.0 supaya bisa diakses dari luar)
HOST=0.0.0.0

# Paksa cookie sesi hanya lewat HTTPS: 1 = selalu, 0 = tidak pernah.
# Kosongkan untuk otomatis (aktif saat NODE_ENV=production / di Vercel).
COOKIE_SECURE=

# Isi 1 bila server berjalan di balik reverse proxy (Nginx/Vercel) supaya
# rate limiter membaca IP pengunjung asli dari X-Forwarded-For.
TRUST_PROXY=

# Isi 1 hanya bila memang ingin voucher contoh (WARUNGMAMI, HEMAT2K yang
# kodenya diketahui publik) ikut dibuat di produksi. Tidak dianjurkan.
SEED_VOUCHERS=

# Pengaman perintah reset data (npm run seed) di produksi: hanya jalan
# bila variabel ini bernilai 1.
FORCE_SEED=
